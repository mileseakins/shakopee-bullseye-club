/** Public read-only data feed. Do not place private information in published tabs. */
const PUBLIC_TABS={players:'Players',teams:'Teams',schedule:'Schedule',results:'Results',news:'News',awards:'Awards'};
function doGet(e){const cb=(e&&e.parameter&&e.parameter.callback)||'';if(cb!=='receiveLeagueData')return ContentService.createTextOutput('Callback not allowed');try{const ss=SpreadsheetApp.getActiveSpreadsheet(),out={};Object.keys(PUBLIC_TABS).forEach(k=>{const sh=ss.getSheetByName(PUBLIC_TABS[k]);if(!sh)throw Error('Missing sheet: '+PUBLIC_TABS[k]);const vals=sh.getDataRange().getDisplayValues(),headers=vals.shift();out[k]=vals.filter(r=>r.some(v=>String(v).trim())).map(r=>Object.fromEntries(headers.map((h,i)=>[h,r[i]||''])))});return ContentService.createTextOutput(cb+'('+JSON.stringify(out)+');').setMimeType(ContentService.MimeType.JAVASCRIPT)}catch(err){return ContentService.createTextOutput(cb+'('+JSON.stringify({error:String(err.message)})+');').setMimeType(ContentService.MimeType.JAVASCRIPT)}}
